{
  "name": "fabric",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev --port 8787",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "node scripts/check-tenancy.mjs && vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply fabric --local",
    "seed:local": "node scripts/seed-local.mjs",
    "pretest": "node -e \"require('fs').mkdirSync('dist/client',{recursive:true})\"",
    "check:tenancy": "node scripts/check-tenancy.mjs"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "hono": "4.10",
    "react": "19.2",
    "react-dom": "19.2",
    "react-router": "7.9"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.10.15",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "5.9",
    "vite": "7.1",
    "vitest": "3.2",
    "wrangler": "4.45"
  }
}
